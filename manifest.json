{
  "manifest_version": 3,
  "name": "Focus Mode",
  "short_name": "Focus Mode",
  "version": "1.1.0",
  "description": "Блокировщик отвлекающих сайтов",
  "author": "bottk123-ctrl",
  "homepage_url": "https://github.com/bottk123-ctrl/chrome-focus-mode",
  "permissions": ["storage", "alarms"],
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": ["lib/matching.js", "lib/format.js", "content.js"],
      "css": ["style.css"]
    }
  ]
}
