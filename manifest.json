{
  "manifest_version": 3,
  "name": "Focus Mode",
  "version": "1.0",
  "description": "Блокировщик отвлекающих сайтов",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
